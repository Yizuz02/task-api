{
  "openapi": "3.0.3",
  "info": {
    "title": "To-do List API",
    "description": "A simple in-memory To-do list API built with Express. Data is stored only in RAM and resets on restart (or via the /reset endpoint).",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local server" }
  ],
  "tags": [
    { "name": "Tasks", "description": "CRUD operations for tasks" },
    { "name": "System", "description": "Health, stats and reset utilities" }
  ],
  "paths": {
    "/api/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List all tasks",
        "description": "Returns all tasks. Supports optional filtering by completion status and title search.",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "description": "Filter tasks by completion status",
            "required": false,
            "schema": { "type": "boolean" }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive search on task title",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a new task",
        "description": "Creates a task. Only 'title' is required in the request body; 'done' defaults to false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskInput" },
              "example": { "title": "Buy groceries" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": {
            "description": "Validation error (missing or invalid title)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a task by id",
        "parameters": [
          { "$ref": "#/components/parameters/TaskId" }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update an existing task",
        "description": "Updates title and/or done status of a task. At least one field should be provided.",
        "parameters": [
          { "$ref": "#/components/parameters/TaskId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskInput" },
              "example": { "title": "Buy groceries and cook dinner", "done": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "parameters": [
          { "$ref": "#/components/parameters/TaskId" }
        ],
        "responses": {
          "204": { "description": "Task deleted successfully (no content)" },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Returns the health/status of the API.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["System"],
        "summary": "Task statistics",
        "description": "Returns the total number of tasks and counts by completion state.",
        "responses": {
          "200": {
            "description": "Task statistics",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Stats" } }
            }
          }
        }
      }
    },
    "/api/reset": {
      "post": {
        "tags": ["System"],
        "summary": "Reset tasks to example data",
        "description": "Restores the in-memory task list to the original 3 example tasks.",
        "responses": {
          "200": {
            "description": "Tasks reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Numeric id of the task",
        "schema": { "type": "integer", "example": 1 }
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Buy groceries" },
          "done": { "type": "boolean", "example": false }
        },
        "required": ["id", "title", "done"]
      },
      "CreateTaskInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Buy groceries" }
        },
        "required": ["title"]
      },
      "UpdateTaskInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Buy groceries and cook dinner" },
          "done": { "type": "boolean", "example": true }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "uptime": { "type": "number", "example": 12.345 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "example": 3 },
          "done": { "type": "integer", "example": 1 },
          "pending": { "type": "integer", "example": 2 }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Task not found" }
        }
      }
    }
  }
}
